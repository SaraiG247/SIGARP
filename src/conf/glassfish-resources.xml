<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE resources PUBLIC "-//GlassFish.org//DTD GlassFish Application Server 3.1 Resource Definitions//EN" "http://glassfish.org/dtds/glassfish-resources_1_5.dtd">
<!--
    Conexión a MySQL que viaja DENTRO de la aplicación (java:app/...),
    así funciona igual en la máquina de cada integrante sin configurar Payara a mano.
    Requisito: copiar mysql-connector-j-8.x.jar a  payara7/glassfish/domains/domain1/lib/
    y reiniciar Payara.
-->
<resources>
    <jdbc-connection-pool name="java:app/sigarpPool"
                          res-type="javax.sql.DataSource"
                          datasource-classname="com.mysql.cj.jdbc.MysqlDataSource"
                          is-connection-validation-required="true"
                          connection-validation-method="auto-commit">
        <property name="serverName" value="localhost"/>
        <property name="portNumber" value="3306"/>
        <property name="databaseName" value="sigarp"/>
        <property name="user" value="sigarp"/>
        <property name="password" value="sigarp123"/>
        <property name="useSSL" value="false"/>
        <property name="allowPublicKeyRetrieval" value="true"/>
        <property name="serverTimezone" value="America/Mexico_City"/>
        <property name="characterEncoding" value="UTF-8"/>
    </jdbc-connection-pool>
    <jdbc-resource jndi-name="java:app/jdbc/sigarp" pool-name="java:app/sigarpPool"/>
</resources>
